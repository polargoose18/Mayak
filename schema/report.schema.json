{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mayak.report/1",
  "description": "Network reachability report. Fields outside this schema are dropped by the validator, not rejected. Limits not expressible here: total size <= 65536 bytes; ts is rounded down to 5 minutes, and ValidateAt also rejects ts older than 24 hours or more than 5 minutes ahead; evidence nesting <= 2 levels (the evidence object is level 1).",
  "type": "object",
  "required": ["schema", "report_id", "ts", "agent", "net", "targets_rev", "results"],
  "properties": {
    "schema": {"const": "mayak.report/1"},
    "report_id": {"type": "string", "pattern": "^[0-9a-f]{10}$"},
    "ts": {"type": "string", "format": "date-time"},
    "agent": {
      "type": "object",
      "required": ["ver", "os", "source"],
      "properties": {
        "ver": {"type": "string", "pattern": "^([0-9]{1,3}\\.[0-9]{1,3}|dev)$"},
        "os": {"enum": ["linux", "windows", "darwin", "android", "ios", "openwrt", "other"]},
        "source": {"enum": ["cli", "web"]}
      }
    },
    "net": {
      "type": "object",
      "required": ["ip_ver", "resolver", "country"],
      "properties": {
        "ip_ver": {"enum": [4, 6]},
        "resolver": {"enum": ["isp", "public", "encrypted", "vpn", "unknown"]},
        "country": {"type": "string", "pattern": "^([A-Z]{2})?$"},
        "region": {"type": ["string", "null"], "pattern": "^[A-Z]{2}-[A-Z0-9]{1,3}$"}
      }
    },
    "targets_rev": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]{1,4}$"},
    "results": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": ["target", "test", "verdict"],
        "properties": {
          "target": {"type": "string", "pattern": "^[a-z0-9-]{1,64}$"},
          "test": {"enum": ["dns", "tcp", "tls_sni", "http", "quic", "tcp_freeze", "throughput", "ctrl"]},
          "verdict": {"enum": ["ok", "dns_tamper", "ip_block", "sni_block", "tls_intercept", "http_stub", "quic_block", "vendor_geoblock", "timeout_unknown", "inconclusive", "vendor_down", "allowlist_mode", "freeze_after_n", "throttled"]},
          "evidence": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [
                {"type": ["string", "number", "boolean", "null"], "maxLength": 200},
                {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"], "maxLength": 200}},
                {"type": "array", "items": {"type": ["string", "number", "boolean", "null"], "maxLength": 200}}
              ]
            }
          }
        }
      }
    }
  }
}
